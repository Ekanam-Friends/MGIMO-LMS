# Скопируй в .env и заполни. .env в репозиторий не коммитится.

# PostgreSQL, драйвер asyncpg. Для быстрой локальной проверки можно sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://lms:<пароль>@localhost:5432/lms
# Пароль для контейнера db из docker-compose.yml — тот же, что в DATABASE_URL.
POSTGRES_PASSWORD=

# Открытый API расписания МГИМО (см. docs/decisions/0002-schedule-source.md).
RUZ_BASE_URL=https://ruz.mgimo.ru/api/
# Нагрузка на РУЗ (чужой сервер). Замер 2026-11-05: на 2 потоках время ответа не растёт,
# на 4 уже растёт. Не поднимать выше 2 без нового замера.
RUZ_CONCURRENCY=2
# Минимальная пауза между началами запросов, секунды.
RUZ_REQUEST_DELAY=0.5

# Соль для генерации вымышленных ФИО преподавателей. Смена соли переименует всех.
FAKE_NAME_SALT=

# Pyrus — система деканата для заявок на справки (см. docs/decisions/0003-dean-office-pyrus.md).
# Логин и Security Key бота Pyrus (Bots → бот → Login / Security Key). Тем же ключом
# проверяется подпись входящего вебхука. Пока пусто — заявки копятся в очереди.
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
# id формы «Справка» в Pyrus (число из адреса формы).
PYRUS_FORM_ID=
# Фоновая сверка открытых заявок, секунды. 0 — только вручную: python -m app.certificates.sync
PYRUS_SYNC_INTERVAL=300

# Сколько дней после готовности студент может скачать PDF справки (потом — «Срок скачивания истёк»).
CERT_DOWNLOAD_DAYS=30

# TTF-шрифт с кириллицей для PDF справок. Пусто — DejaVuSans (Linux) или Arial (Windows).
PDF_FONT_PATH=

# Вход в кабинет (решение 0004). Сколько дней живёт сессия.
SESSION_DAYS=14
# Флаг Secure у cookie сессии. На сервере (https) — true; для локального запуска по http — false.
COOKIE_SECURE=true
# Пароль тестовых учёток student1, student2, dean, которые создаёт python -m app.seed.
DEMO_PASSWORD=
