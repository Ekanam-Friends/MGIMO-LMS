# Скопируй в .env и заполни. .env в репозиторий не коммитится.

# PostgreSQL, драйвер asyncpg. Для быстрой локальной проверки можно sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://lms:<пароль>@localhost:5432/lms
# Пароль для контейнера db из docker-compose.yml — тот же, что в DATABASE_URL.
POSTGRES_PASSWORD=

# Открытый API расписания МГИМО (см. docs/decisions/0002-schedule-source.md).
RUZ_BASE_URL=https://ruz.mgimo.ru/api/
# По умолчанию проверять сертификат. false — только явное исключение для ruz.mgimo.ru.
RUZ_VERIFY_TLS=true
# Нагрузка на РУЗ (чужой сервер). Замер 2026-11-05: на 2 потоках время ответа не растёт,
# на 4 уже растёт. Не поднимать выше 2 без нового замера.
RUZ_CONCURRENCY=2
# Минимальная пауза между началами запросов, секунды.
RUZ_REQUEST_DELAY=0.5

# Соль для генерации вымышленных ФИО преподавателей. Смена соли переименует всех.
FAKE_NAME_SALT=

# Pyrus — система деканата для заявок на справки (см. docs/decisions/0003-dean-office-pyrus.md).
# Логин и Security Key бота Pyrus (Bots → бот → Login / Security Key). Тем же ключом
# проверяется подпись входящего вебхука. Пока пусто — заявки копятся в очереди.
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
# id формы «Справка» в Pyrus (число из адреса формы).
PYRUS_FORM_ID=
# Фоновая сверка открытых заявок, секунды. 0 — только вручную: python -m app.certificates.sync
PYRUS_SYNC_INTERVAL=300

# Сколько дней после готовности студент может скачать PDF справки (потом — «Срок скачивания истёк»).
CERT_DOWNLOAD_DAYS=30

# TTF-шрифт с кириллицей для PDF справок. Пусто — DejaVuSans (Linux) или Arial (Windows).
PDF_FONT_PATH=

# Вход в кабинет (решение 0004). Сколько дней живёт сессия.
SESSION_DAYS=14
# Флаг Secure у cookie сессии. На сервере (https) — true; для локального запуска по http — false.
COOKIE_SECURE=true
# Пароль тестовых учёток student1, student2, dean, которые создаёт python -m app.seed.
DEMO_PASSWORD=

# Кэш чтений: расписание, лента колокольчика, повторные ответы ассистента (решение 0027).
# redis://lms-redis:6379/0 — общий кэш web и бота (в docker-compose.yml задан для обоих сервисов,
# значение здесь перекрывается). Пусто — словарь в памяти процесса: годится для тестов
# и локального запуска, но импорт расписания в боте не сбрасывает кэш web (свежесть — по TTL).
CACHE_URL=
# Страховочные TTL, секунды. Ответы ассистента: 0 — не кэшировать.
CACHE_SCHEDULE_TTL=1800
CACHE_FEED_TTL=60
CACHE_ASSISTANT_TTL=3600

# Telegram-бот (решение 0005). Токен — от @BotFather, только здесь, в коде и HTML его нет.
# Пустой токен — бот не стартует; пустое имя — кабинет не показывает кнопку «Подключить Telegram».
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Lms_university_ekanamfriends_bot
# Если с сервера api.telegram.org доступен с перебоями: http://… или socks5://…
TELEGRAM_PROXY=
# Адрес кабинета снаружи — из него собирается ссылка-подписка на календарь /feed/<токен>.ics.
PUBLIC_BASE_URL=https://lms-university.ekanamfriends.ru
# Как часто бот перечитывает РУЗ по группам подключённых студентов, часы. 0 — не перечитывает.
BOT_IMPORT_HOURS=6
# Чьи группы бот перечитывает: linked — только студентов с Telegram, students — всех студентов
# в базе (включая сгенерированных python -m app.generate). Решение 0011.
BOT_IMPORT_SCOPE=linked
# Если покрытие текущего семестра подтверждено меньше чем у N непустых групп, бот догружает его.
# 0 — выключено. 400 групп ≈ 10 минут при RUZ_CONCURRENCY=2; на 3000 студентов генератора хватает.
BOT_BOOTSTRAP_GROUPS=0

# ИИ-ассистент с поиском по положениям (решение 0007). Все вызовы LLM — только с бэкенда.
# Ключи — только здесь и только на сервере (/opt/mgimo-lms/.env); в коде, HTML и JS их нет.
# Единственный провайдер ассистента: gigachat. Пусто — ассистент выключен.
LLM_PROVIDER=
# GigaChat: ключ авторизации из личного кабинета разработчика, область доступа и модель.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# На нормативных вопросах и проверке применимости проверена Max-модель (решение 0023).
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TRANSLATION_MODEL=GigaChat-2-Max
# Корневой сертификат Минцифры для api.gigachat: файл лежит на сервере в /data/ca/.
# Пусто — берутся системные сертификаты образа.
GIGACHAT_CA_BUNDLE=
# Эмбеддинги берём у провайдера (API), а не считаем локально: torch собирался бы на сервере часами.
# Имя модели эмбеддингов провайдера.
LLM_EMBEDDING_MODEL=
# false — явный режим BM25 без эмбеддингов, если у API не активирован соответствующий пакет.
RAG_USE_EMBEDDINGS=false
# Включать только в демонстрации с полностью вымышленными учебными данными.
ASSISTANT_DEMO_STUDENT_ACCESS=false
# Корпус положений в контейнере (на хосте — /opt/mgimo-lms/data/regulations, см. docs/deploy.md).
RAG_CORPUS_DIR=/data/regulations
# Базовая ширина поиска: отбирается до 3 × K кандидатов с соседними выдержками
# того же акта; общий контекст ограничен 32 000 символов с учётом метаданных.
RAG_TOP_K=5
# Относительные веса рангов BM25 и семантического поиска (RRF); начальные равные веса.
RAG_LEXICAL_WEIGHT=1
RAG_SEMANTIC_WEIGHT=1
# Допустимый возраст ручной проверки источника (дни); просроченные редакции исключаются.
RAG_MAX_SOURCE_AGE_DAYS=30
# Лимит на учётную запись; число запросов на процесс соответствует потокам тарифа API.
RAG_REQUESTS_PER_MINUTE=6
RAG_CONCURRENT_REQUESTS=1
