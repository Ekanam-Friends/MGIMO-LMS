# Скопируй в .env и заполни. .env в репозиторий не коммитится.

# PostgreSQL, драйвер asyncpg. Для быстрой локальной проверки можно sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://lms:<пароль>@localhost:5432/lms
# Пароль для контейнера db из docker-compose.yml — тот же, что в DATABASE_URL.
POSTGRES_PASSWORD=

# Открытый API расписания МГИМО (см. docs/decisions/0002-schedule-source.md).
RUZ_BASE_URL=https://ruz.mgimo.ru/api/
# Пауза между запросами к РУЗ, секунды. Не уменьшать: это чужой сервер.
RUZ_REQUEST_DELAY=1.0

# Соль для генерации вымышленных ФИО преподавателей. Смена соли переименует всех.
FAKE_NAME_SALT=
