# Шаблон секретов для Kubernetes. Обычно не нужен: scripts/k8s-up.sh берёт секреты прямо из .env.
# Если хотите держать секреты кластера отдельно: cp deploy/k8s/secrets.env.example deploy/k8s/secrets.env,
# заполните и запустите K8S_ENV_FILE=deploy/k8s/secrets.env sh scripts/k8s-up.sh.
# deploy/k8s/secrets.env в .gitignore. Значения здесь не заполнять.

# Пароль базы в кластере (только латиница, цифры и . _ ~ -: он подставляется в DATABASE_URL).
POSTGRES_PASSWORD=
# Только для K8S_OVERLAY=external-db: адрес внешней базы, доступный из подов.
# DATABASE_URL=postgresql+asyncpg://lms:<пароль>@<хост>:5432/lms
FAKE_NAME_SALT=
DEMO_PASSWORD=
PYRUS_LOGIN=
PYRUS_SECURITY_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=
GIGACHAT_AUTH_KEY=
