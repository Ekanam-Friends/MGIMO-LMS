# Несекретные настройки кабинета для Kubernetes (решение 0028) -> ConfigMap lms-config.
# Значения по умолчанию взяты из .env.example. Порядок источников в контейнере:
#   1) этот файл (ConfigMap lms-config);
#   2) несекретные непустые строки вашего .env (ConfigMap lms-env, создаёт scripts/k8s-up.sh);
#   3) секреты из .env (Secret lms-secrets, создаёт scripts/k8s-up.sh) — список в ../env-keys.txt.
# Более поздний источник побеждает. Ключи с пометкой managed в ../env-keys.txt из .env
# не берутся: их задаёт кластер (адрес Redis, путь корпуса, внешний адрес, cookie).
#
# Секретов здесь нет и быть не должно: scripts/k8s-validate.py это проверяет.
# PYRUS_FORM_ID намеренно отсутствует: пустое значение не парсится как число, а настоящий
# id формы берётся из .env (без него действует значение из кода — 0, интеграция выключена).

RUZ_BASE_URL=https://ruz.mgimo.ru/api/
RUZ_VERIFY_TLS=true
RUZ_CONCURRENCY=2
RUZ_REQUEST_DELAY=0.5

PYRUS_SYNC_INTERVAL=300
CERT_DOWNLOAD_DAYS=30
PDF_FONT_PATH=

SESSION_DAYS=14
# managed: scripts/k8s-up.sh ставит true только при TLS (K8S_TLS_SECRET), иначе false.
COOKIE_SECURE=false

TELEGRAM_BOT_USERNAME=
# managed: scripts/k8s-up.sh ставит http(s)://<K8S_HOST>.
PUBLIC_BASE_URL=http://lms.local
BOT_IMPORT_HOURS=6
BOT_IMPORT_SCOPE=linked
BOT_BOOTSTRAP_GROUPS=0

LLM_PROVIDER=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TRANSLATION_MODEL=GigaChat-2-Max
# Сертификат Минцифры кладётся в Secret lms-gigachat-ca (необязательный), см. docs/kubernetes.md.
GIGACHAT_CA_BUNDLE=
LLM_EMBEDDING_MODEL=
RAG_USE_EMBEDDINGS=false
ASSISTANT_DEMO_STUDENT_ACCESS=false
# managed: корпус лежит на томе lms-corpus, смонтированном в web по этому пути.
RAG_CORPUS_DIR=/data/regulations
RAG_TOP_K=5
RAG_LEXICAL_WEIGHT=1
RAG_SEMANTIC_WEIGHT=1
RAG_MAX_SOURCE_AGE_DAYS=30
RAG_REQUESTS_PER_MINUTE=6
RAG_CONCURRENT_REQUESTS=1

# managed: Redis внутри кластера (задача #24, кэш). Пока код его не читает — переменная
# просто игнорируется настройками (extra="ignore").
CACHE_URL=redis://redis:6379/0
